<template>
  <view class="metric-strip">
    <view v-for="item in items" :key="item.label" class="metric">
      <text class="metric-label">{{ item.label }}</text>
      <text class="metric-value">{{ item.value }}</text>
      <text v-if="item.detail" class="metric-detail">{{ item.detail }}</text>
    </view>
  </view>
</template>

<script setup lang="uts">
type MetricItem = {
  label: string
  value: string
  detail?: string
}

defineProps<{ items: MetricItem[] }>()
</script>

