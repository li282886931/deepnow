<template>
  <AppShell title="检索测试">
    <view class="page">
      <view class="page-heading">
        <view>
          <text class="eyebrow">RETRIEVAL TEST</text>
          <text class="heading">知识检索测试</text>
          <text class="description">直接测试 Embedding 检索命中结果，不调用语言模型生成。</text>
        </view>
        <button class="secondary" @click="back">返回知识库</button>
      </view>

      <view class="test-card">
        <text class="field-label">查询内容</text>
        <textarea v-model="query" class="query-input" placeholder="输入希望检索的关键词或问题" />
        <button class="primary test-button" :disabled="busy || !query.trim()" @click="runTest">开始检索</button>
      </view>

      <OperationResult :message="message" :tone="messageTone" />
      <ErrorState v-if="errorMessage" title="检索失败" :message="errorMessage" :retry="runTest" />
      <view v-if="result" class="result-card">
        <view class="result-heading">
          <text class="card-title">命中结果</text>
          <text class="score">相似度 {{ displayResult.score.toFixed(4) }}</text>
        </view>
        <text class="result-query">查询：{{ displayResult.query }}</text>
        <text class="match">{{ displayResult.match || "没有找到匹配内容" }}</text>
      </view>
    </view>
  </AppShell>
</template>

<script setup lang="uts">
import { computed, ref } from "vue"
import AppShell from "../../layouts/AppShell.uvue"
import ErrorState from "../../components/ErrorState.uvue"
import OperationResult from "../../components/OperationResult.uvue"
import { testKnowledgeRetrieval } from "../../services/knowledge.uts"
import type { RetrievalResult } from "../../types/domain.uts"

const query = ref("")
const result = ref<RetrievalResult | null>(null)
const displayResult = computed<RetrievalResult>(() => result.value || { query: "", match: "", score: 0 })
const busy = ref(false)
const errorMessage = ref("")
const message = ref("")
const messageTone = ref<"success" | "error" | "info">("info")

async function runTest(): Promise<void> {
  if (!query.value.trim()) return
  busy.value = true
  errorMessage.value = ""
  message.value = ""
  try {
    result.value = await testKnowledgeRetrieval(query.value.trim())
    message.value = "检索完成"
    messageTone.value = "success"
  } catch (error) {
    result.value = null
    errorMessage.value = error instanceof Error ? error.message : "检索失败"
  } finally {
    busy.value = false
  }
}

function back(): void {
  uni.navigateTo({ url: "/pages/knowledge/knowledge" })
}
</script>

<style>
.page { padding: 28px 30px 40px; }
.page-heading { flex-direction: row; align-items: flex-start; justify-content: space-between; }
.eyebrow { display: block; color: #98a2b3; font-size: 10px; letter-spacing: 1px; }
.heading { display: block; color: #101828; font-size: 25px; font-weight: 650; margin-top: 5px; }
.description { display: block; color: #667085; font-size: 13px; margin-top: 7px; }
button { height: 34px; line-height: 34px; margin: 7px 0 0; padding: 0 13px; font-size: 12px; border-radius: 4px; }
.primary { color: #fff; background-color: #175cd3; }
.secondary { color: #344054; background-color: #fff; border: 1px solid #d0d5dd; }
.test-card, .result-card { margin-top: 24px; padding: 18px; background-color: #fff; border: 1px solid #eaecf0; border-radius: 5px; }
.field-label { display: block; color: #344054; font-size: 13px; font-weight: 600; }
.query-input { width: 100%; min-height: 100px; box-sizing: border-box; margin-top: 10px; padding: 10px; color: #344054; border: 1px solid #d0d5dd; border-radius: 4px; font-size: 13px; background-color: #fff; }
.test-button { margin-top: 12px; }
.result-heading { flex-direction: row; align-items: center; justify-content: space-between; }
.card-title { color: #344054; font-size: 15px; font-weight: 600; }
.score { color: #147d55; font-size: 12px; }
.result-query { display: block; color: #667085; font-size: 12px; margin-top: 12px; }
.match { display: block; white-space: pre-wrap; color: #344054; font-size: 13px; line-height: 21px; margin-top: 12px; padding-top: 12px; border-top: 1px solid #f2f4f7; }
@media (max-width: 767px) { .page { padding: 20px 16px 30px; } .page-heading { flex-direction: column; } }
</style>
