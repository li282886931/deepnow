<template>
  <AppShell title="系统诊断">
    <view class="page">
      <view class="page-heading">
        <view>
          <text class="eyebrow">DIAGNOSTICS</text>
          <text class="heading">系统诊断</text>
          <text class="description">检查数据库、激活模型和构建信息，不执行模型请求。</text>
        </view>
        <button class="secondary" :disabled="loading" @click="load">重新检测</button>
      </view>
      <ErrorState v-if="errorMessage && checks.length === 0" title="诊断失败" :message="errorMessage" :retry="load" />
      <OperationResult v-else-if="errorMessage" :message="errorMessage" tone="info" />
      <view v-if="checks.length > 0" class="panel">
        <view v-for="check in checks" :key="check.key" class="check-row">
          <view><text class="check-label">{{ check.label }}</text><text class="check-key">{{ check.key }}</text></view>
          <StatusBadge :label="check.status === 'ok' ? '正常' : check.status === 'error' ? '异常' : '未检测'" :tone="check.status === 'ok' ? 'success' : check.status === 'error' ? 'error' : 'neutral'" />
        </view>
        <view class="build-row"><text>构建信息</text><text>{{ build }}</text></view>
      </view>
    </view>
  </AppShell>
</template>

<script setup lang="uts">
import { onMounted, ref } from "vue"
import AppShell from "../../layouts/AppShell.uvue"
import ErrorState from "../../components/ErrorState.uvue"
import OperationResult from "../../components/OperationResult.uvue"
import StatusBadge from "../../components/StatusBadge.uvue"
import { getDiagnostics } from "../../services/policies.uts"
import type { DiagnosticCheck } from "../../types/domain.uts"

const checks = ref<DiagnosticCheck[]>([])
const build = ref("")
const loading = ref(true)
const errorMessage = ref("")

async function load(): Promise<void> {
  loading.value = true
  errorMessage.value = ""
  try {
    const value = await getDiagnostics()
    checks.value = value.checks
    build.value = value.build
  } catch (error) {
    errorMessage.value = error instanceof Error ? error.message : "无法完成系统诊断"
  } finally {
    loading.value = false
  }
}

onMounted(load)
</script>

<style>
.page { padding: 28px 30px 40px; }
.page-heading { flex-direction: row; align-items: flex-start; justify-content: space-between; }
.eyebrow { display: block; color: #98a2b3; font-size: 10px; letter-spacing: 1px; }
.heading { display: block; color: #101828; font-size: 25px; font-weight: 650; margin-top: 5px; }
.description { display: block; color: #667085; font-size: 13px; margin-top: 7px; }
button { height: 34px; line-height: 34px; margin: 7px 0 0; padding: 0 13px; font-size: 12px; border-radius: 4px; }
.secondary { color: #344054; background-color: #fff; border: 1px solid #d0d5dd; }
.panel { margin-top: 24px; background-color: #fff; border: 1px solid #eaecf0; border-radius: 5px; }
.check-row, .build-row { flex-direction: row; align-items: center; justify-content: space-between; padding: 15px 16px; border-bottom: 1px solid #f2f4f7; }
.check-label, .build-row text:first-child { display: block; color: #344054; font-size: 13px; font-weight: 600; }
.check-key { display: block; color: #98a2b3; font-size: 11px; margin-top: 4px; }
.build-row { color: #667085; font-size: 12px; border-bottom-width: 0; }
@media (max-width: 767px) { .page { padding: 20px 16px 30px; } }
</style>
